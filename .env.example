# Server configuration. Copy to .env; never commit real values.
# Source inspection works without keys, subject to GitHub public rate limits.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Explicitly connect the configured local token in Settings; never shared with other sessions.
GITHUB_TOKEN=
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it
# Explicit initial provider; Settings can override it. No automatic fallback.
DEFAULT_MODEL_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_MODEL=zai-org/GLM-5.3-Flash
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
# Optional locally configured OpenAI-compatible endpoint/model (never set through browser).
CUSTOM_MODEL_BASE_URL=
CUSTOM_MODEL_API_KEY=
CUSTOM_MODEL_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional existing Chromium executable; otherwise use npm run setup:browser.
PLAYWRIGHT_CHROMIUM_PATH=
PORT=3001

# Local durable memory; ignored SQLite database and media (no provider/OAuth keys).
SUDO_DB_PATH=.local/sudo-launch.sqlite
SUDO_RETENTION_DAYS=7

# Optional restricted HTTPS demo. Render supplies RENDER_EXTERNAL_URL automatically.
# Leave empty for localhost. Hosted startup requires both access credentials.
SUDO_PUBLIC_ORIGIN=
SUDO_DEMO_USERNAME=
SUDO_DEMO_PASSWORD=
# Deployment tooling only; do not add this key to the hosted service.
RENDER_API_KEY=
